{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartOnlyTheSoloGaurdRunbooks",
      "Effect": "Allow",
      "Action": "ssm:StartAutomationExecution",
      "Resource": [
        "arn:aws:ssm:af-south-1:<ACCOUNT_ID>:automation-definition/SoloGaurd-QuarantineVictim:$DEFAULT",
        "arn:aws:ssm:af-south-1:<ACCOUNT_ID>:automation-definition/SoloGaurd-DisableVictimAccessKey:$DEFAULT"
      ]
    },
    {
      "Sid": "PassOnlyTheAutomationRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/SoloGaurd-SSMAutomationRole",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ssm.amazonaws.com" }
      }
    }
  ]
}
