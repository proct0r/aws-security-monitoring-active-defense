{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadHoneytokenOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:af-south-1:<ACCOUNT_ID>:secret:Production_Database_Credentials-*"
    }
  ]
}
